<?xml version='1.0' encoding='utf-8'?>
<configuration>
    <input>
        <net-file value="scalable.net.xml" />
        <route-files value="scalable.rou.xml" />
    </input>
    <time>
        <begin value="0" />
        <end value="120" />
        <step-length value="0.1" />
    </time>
    <report>
        <no-step-log value="true" />
        <verbose value="false" />
    </report>
</configuration>